# ==============================================================================
# HostelConnect Environment Variables Template
# Architecture:
# - Backend API: Render (Node/Express Web Service)
# - Database: Supabase (PostgreSQL with Session Pooler on Port 5432)
# - Frontend: Vercel (React Vite SPA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (BACKEND WEB SERVICE) SETTINGS
# Set these in: Render Dashboard -> Your Service -> Environment
# ------------------------------------------------------------------------------

# Node Environment
NODE_ENV=production
PORT=3000

# Supabase PostgreSQL Connection String (Session Pooler - Port 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your_supabase_ref:your_supabase_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# JWT Secret for session authentication (generate with `openssl rand -hex 32`)
JWT_SECRET=your_secure_64_char_random_hex_jwt_secret_placeholder
JWT_EXPIRES_IN=24h

# Allowed Frontend URL for CORS & Cookie Verification (Vercel deployment URL)
# Example: https://hostelconnect.vercel.app (NO trailing slash)
FRONTEND_URL=https://your-hostelconnect-app.vercel.app

# ------------------------------------------------------------------------------
# 2. VERCEL (FRONTEND STATIC SITE) SETTINGS
# Set these in: Vercel Dashboard -> Project Settings -> Environment Variables
# ------------------------------------------------------------------------------

# Render Backend API Base URL
# Example: https://hostelconnect-api.onrender.com (NO trailing slash)
VITE_API_URL=https://your-hostelconnect-api.onrender.com

# ------------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT (OPTIONAL)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# FRONTEND_URL=http://localhost:5173
# VITE_API_URL=http://localhost:3000
