# ==============================================================================
# HostelConnect Environment Variables Template
# Use this template for local .env or Vercel Project Settings > Environment Variables
# ==============================================================================

# Database Configuration (MySQL 8.0)
# For local development: 127.0.0.1
# For Vercel production: your hosted MySQL endpoint (e.g. Aiven, Railway, AWS RDS, GCP Cloud SQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_placeholder
DB_NAME=hostelconnect

# Set to true if your cloud database uses a single master user (e.g. Railway, Aiven, Supabase)
DB_SINGLE_USER=false

# Optional Role-specific database credentials (if 002_roles_and_privileges was applied)
DB_USER_ADMIN=hc_admin
DB_PASSWORD_ADMIN=hc_admin_pass
DB_USER_HOSTEL_OFFICE=hc_hostel_office
DB_PASSWORD_HOSTEL_OFFICE=hc_hostel_office_pass
DB_USER_CHIEF_WARDEN=hc_chief_warden
DB_PASSWORD_CHIEF_WARDEN=hc_chief_warden_pass
DB_USER_WARDEN=hc_warden
DB_PASSWORD_WARDEN=hc_warden_pass
DB_USER_MESS_MANAGER=hc_mess_manager
DB_PASSWORD_MESS_MANAGER=hc_mess_manager_pass
DB_USER_CARETAKER=hc_caretaker
DB_PASSWORD_CARETAKER=hc_caretaker_pass
DB_USER_STUDENT=hc_student
DB_PASSWORD_STUDENT=hc_student_pass

# Server & Security Secrets
PORT=3000
NODE_ENV=production
JWT_SECRET=your_secure_jwt_secret_hex64_placeholder
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# Web Frontend Configuration
VITE_API_URL=http://localhost:3000
