# ==============================================================================
# HostelConnect Production Environment Variables Template
# Copy this file to .env.production before running `docker compose -f docker-compose.prod.yml up`
# ==============================================================================

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ReplaceWithStrongMysqlRootPassword_2026!
DB_NAME=hostelconnect

# API Runtime & Security Secrets (Generate using `openssl rand -hex 32`)
JWT_SECRET=ReplaceWithSecureRandomHex64CharacterJwtSecretKey_2026!
SESSION_SECRET=ReplaceWithSecureRandomHex64CharacterSessionKey_2026!

# Application Domain & Reverse Proxy Settings
NODE_ENV=production
PORT=3000
